  - {fileID: 11400000, guid: 7368a30ed4138364b861a83855b442f4, type: 2}
  - {fileID: 11400000, guid: 3cb71f64084179649bfba5394c7619c7, type: 2}
  - {fileID: 11400000, guid: 763e12dc69feda64f87a4221c5870651, type: 2}
  - {fileID: 11400000, guid: f40aa7797b569754a9b0107274bc65a1, type: 2}
  - {fileID: 11400000, guid: dc7ce146b4417b34aa0188e47ca2a185, type: 2}
  - {fileID: 11400000, guid: 6d2e9387944b34c438364eab78f62d6b, type: 2}
  recallBatteryPrefab: {fileID: 3537673758686987472, guid: 847bc7952bdf6104fb494cd3628cf0ad, type: 3}
  recallSpawnFx: {fileID: 996046671581760345, guid: 927b6c9ea3b147e43941b1656202efb0, type: 3}
  recallOverlapSize: {x: 0.8, y: 0.8}
  dialogue: {fileID: 984494816}
  introLoop1: "\u5636\u2026\u2026\u982D\u597D\u75DB\n\u597D\u50CF\u4E0D\u5C0F\u5FC3\u5F9E\u9AD8\u8655\u6389\u4E0B\u4F86\u6688\u4E86\u4E00\u6BB5\u6642\u9593\n\u70BA\u4E86\u56DE\u661F\u7403\u6642\u4E0D\u7528\u91CD\u65B0\u9069\u61C9\u91CD\u529B\u6240\u4EE5\u88DD\u4E86\u91CD\u529B\u7CFB\u7D71\n\u4F46\u5C0D\u6211\u5011\u9019\u4E9B\u5DF2\u7D93\u7FD2\u6163\u5728\u5916\u592A\u7A7A\u7684\u4EBA\u4F86\u8AAA\u53CD\u800C\u9019\u500B\u624D\u4E0D\u7FD2\u6163\u963F\u2026\u2026\n\u5C0D\u4E86\uFF0C\u6211\u73FE\u5728\u8981\u5FEB\u9EDE\u96E2\u958B\u9019\u88E1\uFF0C\u8981\u628A\u91CD\u8981\u8CC7\u6599\u9001\u56DE\u5730\u7403\n(\u7FFB\u627E)\n\u592A\u597D\u4E86\uFF0C\u5305\u88E1\u679C\u7136\u6709\u5DE5\u5177\n\u96D6\u7136\u597D\u50CF\u8DDF\u6211\u5370\u8C61\u4E2D\u7684\u6578\u91CF\u4E0D\u4E00\u6A23\n\u4F46\u53EA\u8981\u80FD\u5EA6\u904E\u7A7A\u9593\u5DF2\u7D93\u7570\u5E38\u7684\u592A\u7A7A\u8259\u5C31\u597D"
  clearLoop1: "\u6C92\u8FA6\u6CD5\uFF0C\u9084\u6C92\u6210\u529F\n\u8981\u6210\u529F\u555F\u52D5\u592A\u7A7A\u98DB\u8239\u9084\u6709\u8981\u53BB\u8ABF\u6574\u7684\u90E8\u5206\n\u90FD\u602A\u7A7A\u9593\u626D\u66F2\u5BB3\u6211\u8981\u8DD1\u4F86\u8DD1\u53BB\u2026\u2026\uFF01\n\u4E0D\u904E\u6709\u4E9B\u9053\u5177\u5DF2\u7D93\u5FEB\u6490\u4E0D\u4F4F\u4E86\u2026\u2026\u6709\u4EC0\u9EBC\u66FF\u4EE3\u7684\u6771\u897F\u55CE\u2026\u2026\n(\u7FFB\u627E)\n\u554A\uFF0C\u662F\u8F49\u63DB\u69CD\n\u5C0D\u8036\uFF0C\u6211\u600E\u9EBC\u6703\u5FD8\u4E86\u9019\u500B\u6771\u897F\n\u53EA\u8981\u662F\u5B83\u80FD\u5403\u7684\u8CC7\u6E90\uFF0C\u90FD\u53EF\u4EE5\u8F49\u63DB\u6210\u5176\u4ED6\u7269\u54C1\n\u96D6\u7136\u6211\u73FE\u5728\u6C92\u6771\u897F\u53EF\u4EE5\u8F49\u63DB\u4E86\n\u4F46\u6211\u8A18\u5F97\u5B83\u9023\u8A18\u61B6\u90FD\u53EF\u4EE5\u5403\uFF01\n\u53CD\u6B63\u9019\u6BB5\u9003\u96E3\u8A18\u61B6\u4E5F\u4E0D\u503C\u9322\uFF0C\u5C31\u628A\u5B83\u63DB\u4E86\u5427\n\u5E0C\u671B\u5B83\u53EF\u4EE5\u8B8A\u6210\u5E6B\u6211\u812B\u96E2\u9019\u88E1\u7684\u5DE5\u5177"
  introDelay: 0.6
  endingStory: "cg_1\n\u9019\u6A23\u5C31\u80FD\u98DB\u56DE\u5730\u7403\u4E86\u5427\n\u96D6\u7136\u737B\u796D\u4E86\u4E00\u90E8\u5206\u8A18\u61B6\uFF0C\u4F46\u53CD\u6B63\u6211\u4E5F\u611F\u67D3\u4E86\n\u6211\u4EBA\u56DE\u5230\u5730\u7403\u4E5F\u6C92\u6551\u4E86\u2026\u2026\u4E0D\u904E\u81F3\u5C11\n\u6700\u5F8C\u4E00\u6B21\u5B87\u5B99\u65C5\u884C\u662F\u548C\u4F60\u5011\u771F\u597D\n\u5269\u4E0B\u6700\u5F8C\u5E7E\u5206\u9418\uFF0C\u4F86\u804A\u804A\u6211\u5011\u4E4B\u524D\u2026\u2026\n\ncg_2\n\u6B38\n\uFF1F\n\u4E0D\u5C0D\uFF0C\u6211\u4E00\u500B\u4EBA\u2026\u2026\uFF1F\u4E0D\u5C0D\u4E0D\u5C0D\n\u4E0D\u5C0D\u4E0D\u5C0D\n\u4ED6\u5011\u5462\uFF1F\n\ncg_3\n\u2026\u2026\u611F\u67D3\u2026\u2026\u2026\u2026\uFF1F\n\u5C0D\u3001\u5C0D\u4E86\n\u5927\u5BB6\u90FD\u2026\u2026\uFF01\n\ncg_4\n\u6211\u5DF2\u7D93\u6C92\u8FA6\u6CD5\u4E86\n\u597D\u75DB\u82E6\n\u62DC\u8A17\u4F60\uFF0C\u80FD\u91CF\u8F49\u5316\u4F60\u6703\u7528\u5C0D\u5427\uFF1F\u4EA4\u7D66\u4F60\u4E86\n\u4F60\u662F\u6211\u5011\u4E4B\u4E2D\u6700\u52C7\u6562\u7684\n\u4EA4\u7D66\u4F60\u4E00\u5B9A\u53EF\u4EE5\u5B8C\u6210\u4EFB\u52D9\n\u5C31\u7576\u5B8C\u6210\u6211\u7684\u5FC3\u9858\u5427\n\u6211\u81EA\u9858\u4F5C\u70BA\u7269\u54C1\u966A\u4F60\u5011\u8D70\u5230\u6700\u5F8C\n\u56DE\u53BB\u4E86\u518D\u5E6B\u6211\u8DDF\u6211\u5BB6\u4EBA\u8AAA\u6211\u904E\u5F97\u5F88\u958B\u5FC3\n\u5C0D\u4E0D\u8D77\uFF0C\u9EBB\u7169\u4F60\u4E86\u2026\u2026\n\ncg_5\n\u25A0\u25A0\uFF01\u4E0D\u6703\u5427\uFF01\u4ED6\u600E\u9EBC\u771F\u7684\uFF01\uFF01\u9019\u4E0D\u53EF\u80FD\uFF01\uFF01\n\u5225\u62B1\u8457\u5DE5\u5177\u8AAA\u8A71\uFF01\u8DDF\u760B\u5B50\u4E00\u6A23\u2026\u2026\n\u641E\u8457\u6211\u4E5F\u8981\u760B\u4E86\u2026\u2026\n\ncg_6\n\u7A7A\u9593\u626D\u66F2\u5F97\u592A\u56B4\u91CD\uFF01\u6211\u5011\u88AB\u56F0\u4F4F\u4E86\uFF01\n\u4E00\u5B9A\u9084\u6709\u5176\u4ED6\u65B9\u6CD5\uFF01\n\u5225\u641E\u4E86\uFF01\u6C92\u6642\u9593\u4E86\uFF01\u6211\u5011\u90FD\u6D6A\u8CBB\u5E7E\u5C0F\u6642\u5728\u9019\u908A\u4E86\uFF01\n\u4E0D\u53EF\u80FD\uFF0C\u6211\u4E0D\u8981\u2026\u2026\n\u4F60\u5C31\u4FE1\u6211\u7684\u5427\uFF0C\u6211\u7638\u4E86\u4E00\u689D\u817F\u8DDF\u4E00\u96BB\u624B\uFF0C\u73FE\u5728\u6B62\u8840\u4E5F\u5F04\u4E0D\u5B8C\u5168\n\u8B93\u6211\u8B8A\u6210\u5DE5\u5177\u6709\u4EC0\u9EBC\u4E0D\u597D\uFF1F\n\u4E0D\u8981\u60F3\u9019\u4E9B\u8CA0\u9762\u7684\uFF01\u6211\u5011\u4E00\u5B9A\u2026\u2026\u4E00\u5B9A\ncg_7\n\u2026\u2026\n\u25A0\u25A0\u90FD\u5DF2\u7D93\u7528\u5B8C\u4E86\uFF0C\u65E2\u7136\u4ED6\u80FD\u81EA\u9858\u8B8A\u6210\u5DE5\u5177\uFF0C\u70BA\u4EC0\u9EBC\u6211\u4E0D\u884C\n\u6211\u4E0D\u60F3\u7638\u817F\u8DDF\u624B\u6D3B\u5B8C\u4E0B\u534A\u8F29\u5B50\n\u8B93\u6211\u8D70\n\u6211\u4E0D\u8981\uFF01\uFF01\n\ncg_3\n\u4E0D\u7BA1\u662F\u25A0\u25A0\uFF0C\u9084\u662F\u25A0\u25A0\u25A0\u90FD\u2026\u2026\n\u751A\u81F3\u662F\u25A0\u25A0\n\u5927\u5BB6\u90FD\u2026\u2026\n\u90FD\u70BA\u4E86\u8981\u628A\u7D42\u65BC\u7834\u8B6F\u51FA\u4F86\u7684\u611F\u67D3\u8CC7\u6599\u9001\u56DE\u5730\u7403\n\u72A7\u7272\u8B8A\u6210\u5DE5\u5177\u4E86\n\ncg_1\n\u53EF\u60E1\uFF01\uFF01\u5C31\u5DEE\u4E00\u6B65\uFF01\uFF01\n\u8981\u662F\u9084\u6709\u2026\u2026\u9084\u6709\u4E00\u500B\u5DE5\u5177\u7684\u8A71\u2026\u2026\n\u53EF\u60E1\u2026\u2026\u53EF\u60E1\u2026\u2026\n\u6211\u5FEB\u4E0D\u884C\u4E86\u2026\u2026\u597D\u75DB\u82E6\n\u70BA\u4EC0\u9EBC\u504F\u504F\u662F\u6211\u6D3B\u4E0B\u4F86\n\u70BA\u4EC0\u9EBC\u504F\u504F\u53EA\u6709\u6211\u6703\u7528\u8F49\u63DB\u5668\n\u4F46\u5728\u9019\u908A\u6B7B\u6389\u5C31\u8F9C\u8CA0\u4ED6\u5011\u4E86\u2026\u2026\n\u4ED6\u5011\u90FD\u5DF2\u7D93\u2026\u2026\n\u2026\u2026\u2026\u2026\n\ncg_9\n\u2026\u2026\u5C0D\u4E86\n\u8A18\u61B6\u2026\u4E5F\u53EF\u4EE5\u7576\u8F49\u63DB\u8CC7\u6E90\u5427\n\u96D6\u7136\u7406\u8AD6\u4E0A\u662F\u53EF\u4EE5\uFF0C\u4F46\u6C92\u5BE6\u969B\u7528\u904E\uFF0C\u597D\u50CF\u5F88\u5BB9\u6613\u5931\u6557\u7136\u5F8C\u7206\u70B8\n\ncg_3\n\u62B1\u6B49\u4E86\uFF0C\u6211\u4E5F\u597D\u60F3\u8A18\u5F97\u5927\u5BB6\n\u4F46\u5E36\u8457\u6BBA\u4E86\u4F60\u5011\u7684\u8A18\u61B6\uFF0C\u6211\u771F\u7684\u8D70\u4E0D\u4E0B\u53BB\n\u7B49\u6211\u5B8C\u6210\u4EFB\u52D9\u6211\u4E00\u5B9A\u904E\u53BB\u627E\u4F60\u5011\n\u80FD\u6E90\u8F49\u63DB\u2026\u2026\u4F7F\u7528\u8A18\u61B6\u2026\u2026\n\u78BA\u8A8D\n\ncg_10\n\u70BA\u4EC0\u9EBC\u6703\u5728\u6700\u5F8C\u7A81\u7136\u60F3\u8D77\u4F86\n\u8DD1\u99AC\u71C8\u55CE\n\u679C\u7136\u7528\u8A18\u61B6\u7576\u8CC7\u6E90\u9084\u662F\u6709\u9EDE\u7455\u75B5\n\u8981\u628A\u9019\u500B\u6E2C\u8A66\u5831\u544A\u2026\u56DE\u5831\u7D66\u2026\u2026\u2026\n\u2026\u2026\ncg_11\n\n\u3010end\u3011"
